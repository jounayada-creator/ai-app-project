"{\"code\": \"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Essentials Minimalist T-Shirt | Generic Business</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: 'Helvetica Neue', Arial, sans-serif;\n            background: #ffffff;\n            color: #2C2C2C;\n            line-height: 1.6;\n        }\n        \n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 40px 20px;\n        }\n        \n        header {\n            text-align: center;\n            margin-bottom: 60px;\n            border-bottom: 1px solid #e0e0e0;\n            padding-bottom: 30px;\n        }\n        \n        h1 {\n            font-size: 48px;\n            font-weight: 300;\n            letter-spacing: 2px;\n            margin-bottom: 10px;\n        }\n        \n        .tagline {\n            font-size: 16px;\n            color: #666;\n            letter-spacing: 1px;\n            text-transform: uppercase;\n        }\n        \n        .product-section {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 60px;\n            align-items: center;\n            margin-bottom: 80px;\n        }\n        \n        .product-image {\n            background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);\n            aspect-ratio: 1;\n            border-radius: 8px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            overflow: hidden;\n        }\n        \n        .tshirt-mockup {\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(145deg, #ffffff 0%, #f9f9f9 100%);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 120px;\n            color: #e0e0e0;\n        }\n        \n        .product-details h2 {\n            font-size: 32px;\n            font-weight: 400;\n            margin-bottom: 20px;\n            letter-spacing: 1px;\n        }\n        \n        .price {\n            font-size: 28px;\n            font-weight: 300;\n            margin-bottom: 30px;\n            color: #2C2C2C;\n        }\n        \n        .description {\n            font-size: 16px;\n            color: #555;\n            margin-bottom: 30px;\n            line-height: 1.8;\n        }\n        \n        .features {\n            list-style: none;\n            margin-bottom: 40px;\n        }\n        \n        .features li {\n            padding: 12px 0;\n            border-bottom: 1px solid #f0f0f0;\n            font-size: 14px;\n            color: #666;\n        }\n        \n        .features li:before {\n            content: \"✓ \";\n            color: #2C2C2C;\n            font-weight: bold;\n            margin-right: 10px;\n        }\n        \n        .color-options {\n            margin-bottom: 40px;\n        }\n        \n        .color-options label {\n            display: block;\n            font-size: 14px;\n            margin-bottom: 15px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            font-weight: 500;\n        }\n        \n        .color-swatches {\n            display: flex;\n            gap: 15px;\n        }\n        \n        .swatch {\n            width: 50px;\n            height: 50px;\n            border-radius: 4px;\n            cursor: pointer;\n            border: 2px solid transparent;\n            transition: all 0.3s ease;\n        }\n        \n        .swatch:hover {\n            border-color: #2C2C2C;\n            transform: scale(1.05);\n        }\n        \n        .swatch.black {\n            background: #1a1a1a;\n        }\n        \n        .swatch.white {\n            background: #ffffff;\n            border: 2px solid #d0d0d0;\n        }\n        \n        .swatch.gray {\n            background: #b0b0b0;\n        }\n        \n        .cta-button {\n            display: inline-block;\n            padding: 16px 48px;\n            background: #2C2C2C;\n            color: #ffffff;\n            text-decoration: none;\n            font-size: 14px;\n            letter-spacing: 1px;\n            text-transform: uppercase;\n            border: none;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            border-radius: 4px;\n        }\n        \n        .cta-button:hover {\n            background: #1a1a1a;\n            transform: translateY(-2px);\n            box-shadow: 0 8px 24px rgba(0,0,0,0.15);\n        }\n        \n        .specs-section {\n            background: #f9f9f9;\n            padding: 40px;\n            border-radius: 8px;\n            margin-top: 60px;\n        }\n        \n        .specs-section h3 {\n            font-size: 20px;\n            margin-bottom: 25px;\n            letter-spacing: 1px;\n        }\n        \n        .specs-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n        }\n        \n        .spec-item {\n            padding-bottom: 20px;\n        }\n        \n        .spec-label {\n            font-size: 12px;\n            color: #999;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-bottom: 8px;\n        }\n        \n        .spec-value {\n            font-size: 16px;\n            color: #2C2C2C;\n            font-weight: 500;\n        }\n        \n        footer {\n            text-align: center;\n            margin-top: 80px;\n            padding-top: 40px;\n            border-top: 1px solid #e0e0e0;\n            color: #999;\n            font-size: 13px;\n        }\n        \n        @media (max-width: 768px) {\n            .product-section {\n                grid-template-columns: 1fr;\n                gap: 40px;\n            }\n            \n            h1 {\n                font-size: 32px;\n            }\n            \n            .specs-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>ESSENTIALS</h1>\n            <p class=\"tagline\">Minimalist Streetwear Collection</p>\n        </header>\n        \n        <div class=\"product-section\">\n            <div class=\"product-image\">\n                <div class=\"tshirt-mockup\">👕</div>\n            </div>\n            \n            <div class=\"product-details\">\n                <h2>Essentials Tee</h2>\n                <p class=\"price\">$48.00</p>\n                \n                <p class=\"description\">\n                    A timeless minimalist essential. Crafted from premium 100% organic cotton with a geometric line art design. Perfect for the modern wardrobe—versatile, sustainable, and effortlessly stylish.\n                </p>\n                \n                <ul class=\"features\">\n                    <li>100% Organic Cotton Jersey</li>\n                    <li>Geometric Line Art Design</li>\n                    <li>Premium Quality Construction</li>\n                    <li>Sustainable Manufacturing</li>\n                    <li>Available in XS–XXL</li>\n                    <li>Unisex Fit</li>\n                </ul>\n                \n                <div class=\"color-options\">\n                    <label>Select Color:</label>\n                    <div class=\"color-swatches\">\n                        <div class=\"swatch black\" title=\"Black\"></div>\n                        <div class=\"swatch white\" title=\"White\"></div>\n                        <div class=\"swatch gray\" title=\"Heather Gray\"></div>\n                    </div>\n                </div>\n                \n                <button class=\"cta-button\" onclick=\"handleAddToCart()\">Add to Cart</button>\n            </div>\n        </div>\n        \n        <div class=\"specs-section\">\n            <h3>Specifications</h3>\n            <div class=\"specs-grid\">\n                <div class=\"spec-item\">\n                    <div class=\"spec-label\">Material</div>\n                    <div class=\"spec-value\">100% Organic Cotton</div>\n                </div>\n                <div class=\"spec-item\">\n                    <div class=\"spec-label\">Weight</div>\n                    <div class=\"spec-value\">5.3 oz per square yard</div>\n                </div>\n                <div class=\"spec-item\">\n                    <div class=\"spec-label\">Design</div>\n                    <div class=\"spec-value\">Geometric Line Art</div>\n                </div>\n                <div class=\"spec-item\">\n                    <div class=\"spec-label\">Fit</div>\n                    <div class=\"spec-value\">Unisex Classic</div>\n                </div>\n                <div class=\"spec-item\">\n                    <div class=\"spec-label\">Care</div>\n                    <div class=\"spec-value\">Machine wash cold, tumble dry low</div>\n                </div>\n                <div class=\"spec-item\">\n                    <div class=\"spec-label\">Sustainability</div>\n                    <div class=\"spec-value\">GOTS Certified Organic</div>\n                </div>\n            </div>\n        </div>\n        \n        <footer>\n            <p>&copy; 2026 Generic Business. All rights reserved. | Minimalist Streetwear & Digital Products</p>\n        </footer>\n    </div>\n    \n    <script>\n        function handleAddToCart() {\n            const selectedColor = document.querySelector('.swatch.selected');\n            const color = selectedColor ? selectedColor.title : 'Black';\n            alert('Added to cart: Essentials Tee in ' + color);\n            console.log('Product added to cart:', color);\n        }\n        \n        document.querySelectorAll('.swatch').forEach(swatch => {\n            swatch.addEventListener('click', function() {\n                document.querySelectorAll('.swatch').forEach(s => s.classList.remove('selected'));\n                this.classList.add('selected');\n            });\n        });\n        \n        document.querySelector('.swatch.black').classList.add('selected');\n    </script>\n</body>\n</html>\", \"theme\": \"Minimalist Streetwear | Essentials T-Shirt | Geometric Line Art | Monochromatic | Premium Organic Cotton | Sustainable Fashion\", \"timestamp\": \"2026-07-31T08:00:00.000Z\"}"