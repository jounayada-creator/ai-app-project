"{\"code\": \"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Essentials Minimalist T-Shirt | Generic Business</title>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Helvetica Neue', Arial, sans-serif; background: #ffffff; color: #2C2C2C; line-height: 1.6; }\n        .container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }\n        header { text-align: center; margin-bottom: 60px; border-bottom: 1px solid #e0e0e0; padding-bottom: 30px; }\n        h1 { font-size: 48px; font-weight: 300; letter-spacing: 2px; margin-bottom: 10px; }\n        .tagline { font-size: 16px; color: #666; letter-spacing: 1px; text-transform: uppercase; }\n        .product-section { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 80px; }\n        .product-image { background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%); aspect-ratio: 1; border-radius: 8px; display: flex; align-items: center; justify-content: center; }\n        .tshirt-mockup { width: 100%; height: 100%; background: linear-gradient(145deg, #ffffff 0%, #f9f9f9 100%); display: flex; align-items: center; justify-content: center; font-size: 120px; color: #e0e0e0; }\n        .product-details h2 { font-size: 32px; font-weight: 400; margin-bottom: 20px; letter-spacing: 1px; }\n        .price { font-size: 28px; font-weight: 300; margin-bottom: 30px; color: #2C2C2C; }\n        .description { font-size: 16px; color: #555; margin-bottom: 30px; line-height: 1.8; }\n        .features { list-style: none; margin-bottom: 40px; }\n        .features li { padding: 12px 0; border-bottom: 1px solid #f0f0f0; font-size: 14px; color: #666; }\n        .features li:before { content: \"✓ \"; color: #2C2C2C; font-weight: bold; margin-right: 10px; }\n        .color-options { margin-bottom: 40px; }\n        .color-options label { display: block; font-size: 14px; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; font-weight: 500; }\n        .color-swatches { display: flex; gap: 15px; }\n        .swatch { width: 50px; height: 50px; border-radius: 4px; cursor: pointer; border: 2px solid transparent; transition: all 0.3s ease; }\n        .swatch:hover { border-color: #2C2C2C; transform: scale(1.05); }\n        .swatch.black { background: #1a1a1a; }\n        .swatch.white { background: #ffffff; border: 2px solid #d0d0d0; }\n        .swatch.gray { background: #b0b0b0; }\n        .cta-button { display: inline-block; padding: 16px 48px; background: #2C2C2C; color: #ffffff; text-decoration: none; font-size: 14px; letter-spacing: 1px; text-transform: uppercase; border: none; cursor: pointer; transition: all 0.3s ease; border-radius: 4px; }\n        .cta-button:hover { background: #1a1a1a; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.15); }\n        .specs-section { background: #f9f9f9; padding: 40px; border-radius: 8px; margin-top: 60px; }\n        .specs-section h3 { font-size: 20px; margin-bottom: 25px; letter-spacing: 1px; }\n        .specs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; }\n        .spec-item { padding-bottom: 20px; }\n        .spec-label { font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }\n        .spec-value { font-size: 16px; color: #2C2C2C; font-weight: 500; }\n        footer { text-align: center; margin-top: 80px; padding-top: 40px; border-top: 1px solid #e0e0e0; color: #999; font-size: 13px; }\n        @media (max-width: 768px) { .product-section { grid-template-columns: 1fr; gap: 40px; } h1 { font-size: 32px; } .specs-grid { grid-template-columns: 1fr; } }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>ESSENTIALS</h1>\n            <p class=\"tagline\">Minimalist Streetwear Collection</p>\n        </header>\n        <div class=\"product-section\">\n            <div class=\"product-image\">\n                <div class=\"tshirt-mockup\">👕</div>\n            </div>\n            <div class=\"product-details\">\n                <h2>Essentials Tee</h2>\n                <p class=\"price\">$48.00</p>\n                <p class=\"description\">A timeless minimalist essential. Crafted from premium 100% organic cotton with a geometric line art design. Perfect for the modern wardrobe—versatile, sustainable, and effortlessly stylish.</p>\n                <ul class=\"features\">\n                    <li>100% Organic Cotton Jersey</li>\n                    <li>Geometric Line Art Design</li>\n                    <li>Premium Quality Construction</li>\n                    <li>Sustainable Manufacturing</li>\n                    <li>Available in XS–XXL</li>\n                    <li>Unisex Fit</li>\n                </ul>\n                <div class=\"color-options\">\n                    <label>Select Color:</label>\n                    <div class=\"color-swatches\">\n                        <div class=\"swatch black\" title=\"Black\"></div>\n                        <div class=\"swatch white\" title=\"White\"></div>\n                        <div class=\"swatch gray\" title=\"Heather Gray\"></div>\n                    </div>\n                </div>\n                <button class=\"cta-button\" onclick=\"handleAddToCart()\">Add to Cart</button>\n            </div>\n        </div>\n        <div class=\"specs-section\">\n            <h3>Specifications</h3>\n            <div class=\"specs-grid\">\n                <div class=\"spec-item\"><div class=\"spec-label\">Material</div><div class=\"spec-value\">100% Organic Cotton</div></div>\n                <div class=\"spec-item\"><div class=\"spec-label\">Weight</div><div class=\"spec-value\">5.3 oz per square yard</div></div>\n                <div class=\"spec-item\"><div class=\"spec-label\">Design</div><div class=\"spec-value\">Geometric Line Art</div></div>\n                <div class=\"spec-item\"><div class=\"spec-label\">Fit</div><div class=\"spec-value\">Unisex Classic</div></div>\n                <div class=\"spec-item\"><div class=\"spec-label\">Care</div><div class=\"spec-value\">Machine wash cold, tumble dry low</div></div>\n                <div class=\"spec-item\"><div class=\"spec-label\">Sustainability</div><div class=\"spec-value\">GOTS Certified Organic</div></div>\n            </div>\n        </div>\n        <footer>\n            <p>&copy; 2026 Generic Business. All rights reserved. | Minimalist Streetwear & Digital Products</p>\n        </footer>\n    </div>\n    <script>\n        function handleAddToCart() {\n            const selectedColor = document.querySelector('.swatch.selected');\n            const color = selectedColor ? selectedColor.title : 'Black';\n            alert('Added to cart: Essentials Tee in ' + color);\n        }\n        document.querySelectorAll('.swatch').forEach(swatch => {\n            swatch.addEventListener('click', function() {\n                document.querySelectorAll('.swatch').forEach(s => s.classList.remove('selected'));\n                this.classList.add('selected');\n            });\n        });\n        document.querySelector('.swatch.black').classList.add('selected');\n    </script>\n</body>\n</html>\", \"theme\": \"Minimalist Streetwear | Essentials T-Shirt | Geometric Line Art | Monochromatic | Premium Organic Cotton | Sustainable Fashion\", \"timestamp\": \"2026-07-31T08:00:00.000Z\"}"