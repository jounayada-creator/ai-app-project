"{\"code\": \"<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Essentials Minimalist T-Shirt | Generic Business</title><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Helvetica Neue',Arial,sans-serif;background:#fff;color:#2C2C2C;line-height:1.6}.container{max-width:1200px;margin:0 auto;padding:40px 20px}header{text-align:center;margin-bottom:60px;border-bottom:1px solid #e0e0e0;padding-bottom:30px}h1{font-size:48px;font-weight:300;letter-spacing:2px;margin-bottom:10px}.tagline{font-size:16px;color:#666;letter-spacing:1px;text-transform:uppercase}.product-section{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;margin-bottom:80px}.product-image{background:linear-gradient(135deg,#f5f5f5 0%,#fff 100%);aspect-ratio:1;border-radius:8px;display:flex;align-items:center;justify-content:center}.tshirt-mockup{width:100%;height:100%;background:linear-gradient(145deg,#fff 0%,#f9f9f9 100%);display:flex;align-items:center;justify-content:center;font-size:120px;color:#e0e0e0}.product-details h2{font-size:32px;font-weight:400;margin-bottom:20px;letter-spacing:1px}.price{font-size:28px;font-weight:300;margin-bottom:30px}.description{font-size:16px;color:#555;margin-bottom:30px;line-height:1.8}.features{list-style:none;margin-bottom:40px}.features li{padding:12px 0;border-bottom:1px solid #f0f0f0;font-size:14px;color:#666}.features li:before{content:\"✓ \";color:#2C2C2C;font-weight:bold;margin-right:10px}.color-options{margin-bottom:40px}.color-options label{display:block;font-size:14px;margin-bottom:15px;text-transform:uppercase;letter-spacing:1px;font-weight:500}.color-swatches{display:flex;gap:15px}.swatch{width:50px;height:50px;border-radius:4px;cursor:pointer;border:2px solid transparent;transition:all 0.3s ease}.swatch:hover{border-color:#2C2C2C;transform:scale(1.05)}.swatch.black{background:#1a1a1a}.swatch.white{background:#fff;border:2px solid #d0d0d0}.swatch.gray{background:#b0b0b0}.cta-button{display:inline-block;padding:16px 48px;background:#2C2C2C;color:#fff;text-decoration:none;font-size:14px;letter-spacing:1px;text-transform:uppercase;border:none;cursor:pointer;transition:all 0.3s ease;border-radius:4px}.cta-button:hover{background:#1a1a1a;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.15)}.specs-section{background:#f9f9f9;padding:40px;border-radius:8px;margin-top:60px}.specs-section h3{font-size:20px;margin-bottom:25px;letter-spacing:1px}.specs-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:30px}.spec-item{padding-bottom:20px}.spec-label{font-size:12px;color:#999;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}.spec-value{font-size:16px;color:#2C2C2C;font-weight:500}footer{text-align:center;margin-top:80px;padding-top:40px;border-top:1px solid #e0e0e0;color:#999;font-size:13px}@media(max-width:768px){.product-section{grid-template-columns:1fr;gap:40px}h1{font-size:32px}.specs-grid{grid-template-columns:1fr}}</style></head><body><div class=\"container\"><header><h1>ESSENTIALS</h1><p class=\"tagline\">Minimalist Streetwear Collection</p></header><div class=\"product-section\"><div class=\"product-image\"><div class=\"tshirt-mockup\">👕</div></div><div class=\"product-details\"><h2>Essentials Tee</h2><p class=\"price\">$48.00</p><p class=\"description\">A timeless minimalist essential. Crafted from premium 100% organic cotton with a geometric line art design. Perfect for the modern wardrobe—versatile, sustainable, and effortlessly stylish.</p><ul class=\"features\"><li>100% Organic Cotton Jersey</li><li>Geometric Line Art Design</li><li>Premium Quality Construction</li><li>Sustainable Manufacturing</li><li>Available in XS–XXL</li><li>Unisex Fit</li></ul><div class=\"color-options\"><label>Select Color:</label><div class=\"color-swatches\"><div class=\"swatch black\" title=\"Black\"></div><div class=\"swatch white\" title=\"White\"></div><div class=\"swatch gray\" title=\"Heather Gray\"></div></div></div><button class=\"cta-button\" onclick=\"handleAddToCart()\">Add to Cart</button></div></div><div class=\"specs-section\"><h3>Specifications</h3><div class=\"specs-grid\"><div class=\"spec-item\"><div class=\"spec-label\">Material</div><div class=\"spec-value\">100% Organic Cotton</div></div><div class=\"spec-item\"><div class=\"spec-label\">Weight</div><div class=\"spec-value\">5.3 oz per square yard</div></div><div class=\"spec-item\"><div class=\"spec-label\">Design</div><div class=\"spec-value\">Geometric Line Art</div></div><div class=\"spec-item\"><div class=\"spec-label\">Fit</div><div class=\"spec-value\">Unisex Classic</div></div><div class=\"spec-item\"><div class=\"spec-label\">Care</div><div class=\"spec-value\">Machine wash cold, tumble dry low</div></div><div class=\"spec-item\"><div class=\"spec-label\">Sustainability</div><div class=\"spec-value\">GOTS Certified Organic</div></div></div></div><footer><p>&copy; 2026 Generic Business. All rights reserved. | Minimalist Streetwear & Digital Products</p></footer></div><script>function handleAddToCart(){const selectedColor=document.querySelector('.swatch.selected');const color=selectedColor?selectedColor.title:'Black';alert('Added to cart: Essentials Tee in '+color);}document.querySelectorAll('.swatch').forEach(swatch=>{swatch.addEventListener('click',function(){document.querySelectorAll('.swatch').forEach(s=>s.classList.remove('selected'));this.classList.add('selected');});});document.querySelector('.swatch.black').classList.add('selected');</script></body></html>\", \"theme\": \"Minimalist Streetwear | Essentials T-Shirt | Geometric Line Art | Monochromatic | Premium Organic Cotton | Sustainable Fashion\", \"timestamp\": \"2026-07-31T08:00:00.000Z\"}"